# =====================================================================
# .gitignore — Python + Jupyter + ML/GenAI
# =====================================================================

# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
*.egg
.eggs/
pip-log.txt
pip-delete-this-directory.txt

# ---------- Virtual environments ----------
.venv/
venv/
env/
ENV/
.python-version

# ---------- Jupyter ----------
.ipynb_checkpoints/
*-checkpoint.ipynb
.jupyter/
profile_default/
ipython_config.py

# ---------- Secrets / API keys (Sections 5–7) ----------
# Never commit credentials.
.env
.env.*
*.env
# Whitelist the public template — committed so participants know which key to set:
!.env.example
secrets.json
credentials.json
*.key
*.pem

# ---------- ML / GenAI caches and artifacts ----------
.cache/
.huggingface/
huggingface_cache/
.transformers_cache/
torch_cache/
mlruns/
wandb/
lightning_logs/
tensorboard_logs/
runs/
# CatBoost training-run artifacts (per-section):
notebooks/**/catboost_info/

# ---------- Model files (usually too large for git) ----------
*.ckpt
*.pt
*.pth
*.h5
*.hdf5
*.onnx
*.safetensors
*.bin
*.gguf

# ---------- Optional: auto-downloaded datasets ----------
# Uncomment if you want to keep large downloaded datasets out of git.
# notebooks/**/data/downloaded/
# notebooks/**/data/*.zip
# notebooks/**/data/*.tar.gz

# Section 04 auto-downloads Folktables ACS / CIFAR-10 / MNIST / Roboflow car_damage at runtime.
notebooks/04_special_topics_ml/data/2018/
notebooks/04_special_topics_ml/data/cifar10/
notebooks/04_special_topics_ml/data/mnist/
notebooks/04_special_topics_ml/data/car_damage/

# ---------- Notebook-generated figures (regenerated by running the notebooks) ----------
notebooks/**/figures/

# ---------- Testing / coverage ----------
.coverage
.coverage.*
.pytest_cache/
.tox/
.nox/
htmlcov/
.mypy_cache/
.ruff_cache/

# ---------- IDEs / editors ----------
.vscode/
.idea/
*.swp
*.swo
*.swn
.spyderproject
.spyproject

# ---------- Operating systems ----------
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db

# ---------- Misc ----------
*.log
*.tmp
*.bak
